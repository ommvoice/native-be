{
  "name": "native-be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test":       "vitest run",
    "test:watch": "vitest",

    "___ INSTALL ___":   "",
    "install:all":       "npm install && npm install --prefix cdk && npm install --prefix layers",

    "___ CDK ___":       "",
    "cdk:bootstrap":     "cd cdk && npm install && npx cdk bootstrap",
    "cdk:synth":         "cd cdk && npx cdk synth --all",

    "___ DEPLOY ___": "",
    "deploy:dev":     "cd cdk && npx cdk deploy --all --require-approval never --context env=dev",
    "deploy:staging": "cd cdk && npx cdk deploy --all --require-approval never --context env=staging",
    "deploy:prod":    "cd cdk && npx cdk deploy --all --require-approval never --context env=prod",

    "___ DESTROY ___": "",
    "destroy:dev":     "cd cdk && npx cdk destroy --all --force --context env=dev",
    "destroy:staging": "cd cdk && npx cdk destroy --all --force --context env=staging",
    "destroy:prod":    "cd cdk && npx cdk destroy --all --force --context env=prod",

    "___ DEPLOY + SEED (one command) ___": "",
    "up:dev":     "npm run deploy:dev     && APP_ENV=dev     npm run seed:all",
    "up:staging": "npm run deploy:staging && APP_ENV=staging npm run seed:all",
    "up:prod":    "npm run deploy:prod",

    "___ SEED ___": "",
    "seed:interests":          "tsx seed/interests.ts",
    "seed:facilities":         "tsx seed/facilities.ts",
    "seed:skills":             "tsx seed/skills.ts",
    "seed:themes":             "tsx seed/themes/all.ts",
    "seed:themes:nature":      "tsx seed/themes/nature-exploration.ts",
    "seed:themes:movement":    "tsx seed/themes/movement-energy.ts",
    "seed:themes:creativity":  "tsx seed/themes/creativity-imagination.ts",
    "seed:themes:learning":    "tsx seed/themes/learning-curiosity.ts",
    "seed:themes:slowing":     "tsx seed/themes/slowing-down.ts",
    "seed:themes:together":    "tsx seed/themes/together-time.ts",
    "seed:themes:special":     "tsx seed/themes/special-memorable.ts",
    "seed:variants":           "tsx seed/variants/all.ts",
    "seed:opp-themes":         "tsx seed/opportunity/themes.ts",
    "seed:opp-v2:clubs":       "tsx seed/opportunity/clubs-v2.ts",
    "seed:opp-v2:events":      "tsx seed/opportunity/events-v2.ts",
    "seed:opp-v2:routes":      "tsx seed/opportunity/routes-v2.ts",
    "seed:opp-v2:venues":      "tsx seed/opportunity/venues-v2.ts",
    "seed:demo-user":          "tsx seed/demo/demo-user.ts",
    "seed:demo-rec":           "tsx seed/demo/recommendations.ts",
    "seed:demo-swagger":       "tsx seed/demo/swagger-corridor.ts",
    "seed:all":                "tsx seed/index.ts",

    "___ LAYER ___": "",
    "layer:install": "cd layers && npm install"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/http-errors": "^2.0.4",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1058.0",
    "@aws-sdk/client-dynamodb": "^3.1058.0",
    "@aws-sdk/lib-dynamodb": "^3.1058.0",
    "@middy/core": "^7.6.5",
    "@middy/http-cors": "^7.6.5",
    "@middy/http-error-handler": "^7.6.5",
    "@middy/http-json-body-parser": "^7.6.5",
    "aws-jwt-verify": "^5.1.1",
    "dotenv": "^17.4.2",
    "http-errors": "^2.0.0",
    "http-status-codes": "^2.3.0",
    "uuid": "^14.0.0",
    "yup": "^1.7.1"
  }
}
